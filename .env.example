# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM Provider (Google Gemini) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Gmail OAuth ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/client_secret.json
# Where the user's OAuth token cache is stored after the consent flow.
GOOGLE_OAUTH_TOKEN_FILE=./secrets/token.json
GMAIL_USER_EMAIL=

# --- ChromaDB / RAG ---
CHROMA_PERSIST_DIR=./data/chroma
RAG_EMBEDDING_MODEL=models/gemini-embedding-2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# --- Safety ---
REQUIRE_APPROVAL_BEFORE_SEND=true
APPROVAL_TTL_SECONDS=1800

# --- Agent execution limits ---
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_TOOL_RETRIES=2
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_EXECUTION_SECONDS=120
AGENT_MAX_OUTPUT_CHARS=12000

# --- Reliability ---
GMAIL_MAX_RETRIES=2
GMAIL_RETRY_BASE_DELAY_SECONDS=0.5
