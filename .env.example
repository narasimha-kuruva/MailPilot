# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
# Comments stay on their own lines: `docker run --env-file` keeps an inline
# "# ..." as part of the value.
# development | staging | production (reported by /health only)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Anyone who can call the API can read the mailbox and approve sends.
# Without MAILPILOT_API_KEY, only requests from this machine are accepted;
# with it, every request must send the key (X-API-Key or Authorization: Bearer).
# Set a key before exposing MailPilot beyond this machine, including Docker.
API_HOST=127.0.0.1
# At least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MAILPILOT_API_KEY=
API_PORT=8000

# --- LLM provider selection (deterministic: MailPilot never falls back between them) ---
# ollama (default): local model via Ollama, no API quota. Models are NOT downloaded
#         by MailPilot -- install Ollama from https://ollama.com, then run:
#           ollama pull gemma4:e2b
#           ollama pull embeddinggemma    # only needed for the RAG tools
# gemini: hosted Google Gemini (needs GOOGLE_API_KEY; free tier is 20 requests/day/model).
# Switch by changing this one value and restarting; no code changes are needed.
LLM_PROVIDER=ollama

# --- Google Gemini -- used only when LLM_PROVIDER=gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# --- Local LLM (Ollama) -- used only when LLM_PROVIDER=ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Context window in tokens. Ollama's own default (4096) is too small for the system
# prompt + tool schemas + one full email; gemma4:e2b supports up to 131072.
OLLAMA_NUM_CTX=16384

# --- Gmail OAuth ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=./secrets/client_secret.json
# Where the user's OAuth token cache is stored after the consent flow.
GOOGLE_OAUTH_TOKEN_FILE=./secrets/token.json
GMAIL_USER_EMAIL=

# --- ChromaDB / RAG ---
CHROMA_PERSIST_DIR=./data/chroma
RAG_EMBEDDING_MODEL=models/gemini-embedding-2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# --- Safety ---
REQUIRE_APPROVAL_BEFORE_SEND=true
APPROVAL_TTL_SECONDS=1800

# --- Agent execution limits ---
AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_TOOL_RETRIES=2
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_EXECUTION_SECONDS=120
AGENT_MAX_OUTPUT_CHARS=12000
# Model-call resilience: transient 503/429/timeouts from the LLM API are retried
# with backoff (never past AGENT_MAX_EXECUTION_SECONDS). Raise the timeout for
# slow local CPU-only models.
AGENT_MAX_LLM_RETRIES=3
AGENT_LLM_RETRY_BASE_DELAY_SECONDS=2.0
AGENT_LLM_TIMEOUT_SECONDS=60
# Tool calls the model makes in one turn run together, at most this many at once.
AGENT_MAX_PARALLEL_TOOL_CALLS=4

# --- Reliability ---
# Gmail meters query cost per user per minute; bursts get a 403 rateLimitExceeded.
# Retried with backoff (1s, 2s, 4s); fetches per search are throttled.
GMAIL_MAX_RETRIES=3
GMAIL_RETRY_BASE_DELAY_SECONDS=1.0
GMAIL_MAX_CONCURRENT_FETCHES=5
# Messages and threads read in the last N seconds are reused (searches never
# are; any label/draft/send clears it). 0 turns the cache off.
GMAIL_CACHE_SECONDS=30

# --- Persistence ---
# sqlite: conversations, pending approvals, the audit trail and sends that
# already went out survive a restart (SQLite files under STATE_DIR).
# memory: all of it is lost on restart. Run a single worker either way.
STATE_BACKEND=sqlite
STATE_DIR=./data/state

# --- Observability ---
# Per-token prices (USD per million tokens) for the cost estimate in
# GET /api/v1/metrics. 0 turns the estimate off; fill in your plan's current
# prices to enable it. A local Ollama model costs nothing per token.
LLM_INPUT_USD_PER_MILLION_TOKENS=0
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0
